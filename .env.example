# Adbot Tracking Platform — example environment file
#
# The shipped WordPress plugin does NOT read this file. It exists only for
# contributors who run their own fork of the Adbot backend locally. The
# plugin's runtime configuration is the two optional wp-config.php constants
# documented in README.md (ADBOT_API_BASE, ADBOT_DEBUG).
#
# Copy to `.env.local` (which is gitignored) and fill in your own values.
# Never commit real secrets.

# Google OAuth (only needed if you run your own backend fork).
client_id=your-google-oauth-client-id.apps.googleusercontent.com
client_secret=replace-me

# Supabase — only needed when running a self-hosted Adbot backend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_replace-me
NEXT_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_KEY=replace-me

# AES-256 key for OAuth-token encryption at rest (base64, 32 bytes).
# Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me

# Paystack — test keys are fine for local dev.
PAYSTACK_SECRET_KEY=sk_test_replace-me
PAYSTACK_PUBLIC_KEY=pk_test_replace-me
ADBOT_FIX_CURRENCY=ZAR
ADBOT_FIX_PRICE=499
